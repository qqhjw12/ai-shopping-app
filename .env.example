# ===== AI Gateway 配置（复制为 .env 后填写，真实密钥勿提交） =====

# 服务端口
PORT=8080

# 运行模式：local（无 Docker，本地 SQLite + 内置对话引擎） | docker（接真实 Qdrant/ES/Ollama/mall）
RUN_MODE=local

# ===== 本地数据库（SQLite，Node 22 内置，无需安装任何东西） =====
# 商品 / SKU / 订单 / 评价 / 会话消息 / 埋点全部落这个文件，重启不丢
DB_FILE=data/shop.db

# ===== 可选：接入大模型（OpenAI 兼容协议）=====
# 留空 LLM_API_KEY 时走内置本地对话引擎（完全离线可用，基于 SQLite 真实数据回答）
# 填 Key 后自动升级为真大模型：DeepSeek / 通义千问 / Kimi / OpenAI 均兼容
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_TIMEOUT_MS=30000

# 嵌入提供方：ollama | local（本地哈希嵌入，零依赖、可离线演示）
EMBEDDING_PROVIDER=local

# Ollama（docker 模式使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# 向量库 Qdrant（docker 模式使用）
QDRANT_URL=http://localhost:6333

# 搜索引擎 Elasticsearch（docker 模式使用）
ELASTICSEARCH_URL=http://localhost:9200

# mall 内部 API（供 Agent 回调商品/订单，M2+ 使用）
MALL_BASE_URL=http://localhost:8081

# 混合搜索权重（向量 + 关键词）
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# ===== Dify 中枢（智能客服 + 商品问答 + 后续模块） =====
# docker 模式下设置以下 Key 后，ai-gateway 会自动从 local 降级切换为调用真实 Dify
DIFY_API_URL=http://localhost:5001/v1
# Dify 应用 API Key（在 Dify 控制台「应用 -> 访问 API」获取，分别建 App）
DIFY_CS_API_KEY=
DIFY_PQA_API_KEY=
# AI 导购 App Key（Dify Agent，可回调 mall /api/ai/products）
DIFY_SG_API_KEY=
# 运营文案 Workflow App Key（运营同事在 Dify 控制台自助使用的「无代码后台」）
DIFY_CW_API_KEY=
# 订单售后 Workflow App Key（运营/用户自助查单、发起售后）
DIFY_AS_API_KEY=
# 商品问答知识库：把 mall 商品同步进 Dify Dataset 所需的凭证
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
DIFY_RETRIEVAL_LIMIT=3

# CORS：逗号分隔的显式允许来源；留空则默认允许本地演示来源
# 生产必须显式配置（如 http://your-domain.com），严禁使用 '*'
CORS_ORIGINS=

# ===== AI Gateway 加固（M5） =====
# 访问鉴权：设置后所有业务接口（除 /health、/ready）需携带 X-API-Key 头
# 生产务必设置；留空则对外开放（仅限演示/内网）
AI_GATEWAY_API_KEY=
# 限流：每 IP 每分钟最大请求数（0 表示不限流，仅演示）
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_WINDOW_MS=60000
# 若 Gateway 前置反向代理（nginx 等），置 true 以从 X-Forwarded-For 取真实 IP
TRUST_PROXY=false

# ===== 运营配置（运费 / 配送方式 / 券返还顺延规则）=====
# 写入 PUT /api/config 需要请求头 X-Admin-Key 与此值一致；留空则配置只读。
# 生成方式：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 千万不要用示例值上线，也不要提交真实值。
ADMIN_API_KEY=

# ===== 买家秀上传加固 =====
# 单张原始字节上限（base64 解码后），默认 6MB
UPLOAD_MAX_BYTES=6291456
# 每用户每分钟上传次数（0 关闭）
UPLOAD_RATE_PER_MIN=10
# 每用户每 24 小时上传配额（0 关闭）
UPLOAD_DAILY_QUOTA=200
# 全局同时处理的上传数上限，防并发大 body 打爆内存（0 关闭）
UPLOAD_MAX_CONCURRENT=4

# ===== 认证：JWT 访问令牌 + 服务端刷新令牌 =====
# HS256 签名密钥；生产必须配置固定值。留空时 local 模式生成临时密钥（重启后令牌全部失效）
AUTH_JWT_SECRET=
# 访问令牌有效期（秒），默认 15 分钟
AUTH_ACCESS_TTL_SEC=900
# 刷新令牌有效期（秒），默认 14 天；刷新即轮换，旧令牌一次性作废
AUTH_REFRESH_TTL_SEC=1209600
# true：业务接口必须携带有效访问令牌（/api/auth/login、/api/auth/refresh 除外）
AUTH_REQUIRED=false
# 刷新令牌 Cookie 名与 Secure 开关（生产 HTTPS 必须置 true）
AUTH_COOKIE_NAME=rt
AUTH_COOKIE_SECURE=false

# ===== HTTPS 反向代理（nginx 一键脚本 scripts/setup-https-proxy.sh） =====
# 对外 HTTPS 监听端口（自签名演示默认 8443，正式部署用 443）
HTTPS_PORT=8443
# 对外域名 / IP（自签名演示用 localhost）
DOMAIN=localhost
# 可选：提供正式证书则填绝对路径，否则脚本自动生成自签名证书到 nginx/tls/
# TLS_CERT=
# TLS_KEY=

# ===== mall-ai 集成模块（fork macrozheng/mall 后新增的模块） =====
# Gateway 回调 mall 的地址（docker 网络内为 http://mall:8081）
MALL_BASE_URL=http://localhost:8081
# 内部回调共享密钥（可选，mall-ai 端校验 X-AI-Gateway-Key 头）
AI_GATEWAY_KEY=

# ===== 买家秀对象存储（评价图片上传）=====
# local: 落 ai-gateway/data/uploads，零依赖，适合本地演示 / 单实例
# s3   : 落 S3 兼容对象存储（SeaweedFS / MinIO / 阿里云 OSS / Cloudflare R2 / AWS S3）
#        读取走「预签名 URL」，库里只存对象键，不存 URL
STORAGE_DRIVER=local
# S3 / S3 兼容端点（本地替身：bash scripts/dev-storage.sh 会打印实际值）
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=review-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 本地替身（SeaweedFS/MinIO）用 path-style；真 AWS 设 0
S3_FORCE_PATH_STYLE=1
# 预签名 URL 有效期（秒），默认 15 分钟；越短越安全
MEDIA_URL_TTL_SECONDS=900
# 孤儿对象清理周期（秒）：回收「上传未发布 / 评价删除后残留」的图片对象；0 关闭（默认 1800）
STORAGE_SWEEP_INTERVAL_SEC=1800
