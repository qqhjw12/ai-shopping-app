# 环境变量（含密钥，禁止提交；仅 .env.example 入库）
.env
.env.local

# 生成的 TLS 证书 / 私钥（一键脚本产出）
nginx/tls/

# mall fork（克隆产物）与本地导入库（仅根目录的 db/，不要误伤 src/db）
/mall-fork/
/db/

# 本地 SQLite 数据文件（运行时生成，seedDb 可重建，不入库）
ai-gateway/data/

# 真实数据导入缓存：快照入库，保证全新克隆也能离线 `npm run db:ingest` 复现真实商品
# （如需精简仓库，可忽略本目录并改用 `npm run db:ingest -- --fetch` 实时抓取）
# 但下划线开头的临时/调试脚本一律不入库（如本地静态服务、一次性校验脚本）
ai-gateway/.cache/_*.mjs

# 依赖 / 构建产物
node_modules/
.mvn/
target/

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log

# Python 缓存（scripts/dev_server.py 运行时可能生成）
__pycache__/
*.pyc

# 本地记忆 / 工作区元数据（非项目代码）
.workbuddy/
