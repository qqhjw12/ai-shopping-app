{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Gateway for shopping app (Route A) - hybrid search over Qdrant + Elasticsearch",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "db:seed": "node --disable-warning=ExperimentalWarning src/db/seedDb.js",
    "db:reset": "node --disable-warning=ExperimentalWarning src/db/seedDb.js --reset",
    "sync:dify": "node scripts/sync-products-to-dify.js"
  },
  "engines": {
    "node": ">=20"
  }
}
